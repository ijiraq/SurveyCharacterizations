# MPC complete survey: detected when H_r is below
# h_lim = 5.42 for an object at opposition (make_pointings.py).
# earth: jd= 2461260.37836 r_e= 1.014058 v_e= 29.3739 phase= 0.0328
# Per rate range: single tanh, m0 = M0 + alpha_rate * rate ["/hr], exact
# at the range's distance edges; max |m0 - m_lim| inside is given.
rate_cut= 0.0 20.0 0.0 180.0
track_frac= 1.0 99.0 0.0
mag_error= 0.001 0.0 99.0 0.0 99.0 0.0
phot_frac= 1.0 0.0 0.0
filter= r
# r from 62 to 100 au; max error 0.114 mag
rates= 0.0000 2.0829
function= single
single_param= 1.0 29.0736 0.05 -2.75231
